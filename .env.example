# .env.example
# AI Novel Generator 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== 数据库配置 ====================
DB_USER=novelgen
DB_PASSWORD=change_this_password_123456
DB_NAME=novel_generator
DB_HOST=database
DB_PORT=5432

# 完整数据库URL（优先级高于上面的单独配置）
# DATABASE_URL=postgresql://novelgen:password@database:5432/novel_generator

# ==================== 安全配置 ====================
# JWT密钥（必须修改！使用随机字符串）
SECRET_KEY=your-very-secret-key-change-this-to-random-string-in-production

# ==================== API配置 ====================
# OpenAI API密钥
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API基础URL（可选，国内用户可能需要）
# OPENAI_BASE_URL=https://your-proxy-url.com/v1

# ==================== 应用配置 ====================
# 环境类型：development, production
ENVIRONMENT=production

# 后端端口
BACKEND_PORT=8000

# 前端端口
FRONTEND_PORT=80

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=./logs

# ==================== CORS配置 ====================
# 允许的跨域源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ==================== 文件存储配置 ====================
# 数据目录
DATA_DIR=./data

# 上传文件最大大小（MB）
MAX_UPLOAD_SIZE=100

# ==================== Redis配置（用于缓存和Celery结果存储）====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_this
REDIS_DB=0

# ==================== RabbitMQ配置（用于Celery消息队列）====================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin_password_change_this
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==================== Celery配置（异步任务队列）====================
# Celery Broker URL (使用RabbitMQ)
CELERY_BROKER_URL=amqp://admin:admin_password_change_this@rabbitmq:5672//

# Celery Result Backend (使用Redis)
CELERY_RESULT_BACKEND=redis://:redis_password_change_this@redis:6379/2

# Celery Worker并发数
CELERY_WORKER_CONCURRENCY=4

# ==================== Email配置（可选，用于通知）====================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@example.com
